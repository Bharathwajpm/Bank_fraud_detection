# ==============================================================================
# Banking Fraud Detection MLOps - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=production

# Frontend Service Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# CORS Allowed Origins (comma-separated list of origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Model & Inference Settings
MODEL_VERSION=1.0.0
DECISION_THRESHOLD=0.50

# MLOps & Experiment Tracking Configuration
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=bank-fraud-detection
MLFLOW_PORT=5000

# Monitoring & Logging
LOG_LEVEL=INFO
PREDICTION_LOG_PATH=logs/predictions.jsonl
DRIFT_WINDOW_SIZE=100
