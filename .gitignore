# ==============================================================================
# Git Ignore Rules for Banking Fraud Detection MLOps
# ==============================================================================

# Environment & Secrets (Keep .env.example tracked)
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Virtual Environments
.venv/
venv/
ENV/
env/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Pytest Cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Prediction & Application Logs (preserve directory structure)
logs/*.jsonl
logs/*.log
!logs/.gitkeep

# MLflow Local Tracking & SQLite Artifacts
mlruns/
mlflow.db
mlflow.db-journal
.trash/

# Node.js & Frontend Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/

# IDE, OS, & Editors
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
